# Set these secrets in the local .env file or Vercel Environment Variables.
GEMINI_API_KEY=
CHAT_SERVICE_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=LOW

# Local example. For Vercel use the Redis provider's native connection URL.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=focuslens
CHAT_SESSION_TTL_SECONDS=10800
